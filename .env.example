# ==============================================================================
# Environment Configuration Template (.env.example)
# SIH 2026 — PS26057: MarineDebris-Sonar-AI
# Copy this file to .env and adjust values for your local environment.
# DO NOT COMMIT REAL SECRETS OR SENSITIVE PASSWORDS TO VERSION CONTROL.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-this-insecure-secret-key-in-production
LOG_LEVEL=INFO

# Database Configuration
# Default: Embedded SQLite for zero-setup standalone deployment (works immediately on any machine)
DATABASE_URL=sqlite+aiosqlite:///./data/marine_debris_sonar.db

# For PostgreSQL / Docker deployments, uncomment below:
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=marine_debris_sonar
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/marine_debris_sonar

# Redis (optional for Docker / clustered production)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# Celery (true = in-memory standalone mode without needing Redis daemon)
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=true

# Storage & Uploads — ARCHITECTURAL_BLUEPRINT.md §10
STORAGE_TYPE=local
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=./data/storage
STORAGE_ROOT=./data/storage
MAX_UPLOAD_SIZE_MB=2048

# MinIO / S3-compatible storage (when STORAGE_TYPE=minio)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=marine-debris
MINIO_SECURE=false

# Models — ARCHITECTURAL_BLUEPRINT.md §9, §10
DETECTION_MODEL_PATH=models/detection/sonar_yolov8m_ghostpot_v1.pt
SEGMENTATION_MODEL_PATH=models/segmentation/unet_shipwreck_v1.pt
DETECTION_CONF_THRESHOLD=0.35
NMS_IOU_THRESHOLD=0.45
CALIBRATION_TEMPERATURE=1.4

# Processing — ARCHITECTURAL_BLUEPRINT.md §5, §10
TILE_SIZE=640
TILE_OVERLAP=0.2
CHUNK_SIZE_PINGS=2000
DEVICE=cuda

# CORS — ARCHITECTURAL_BLUEPRINT.md §10
API_CORS_ORIGINS=http://localhost:5173

# Frontend Configuration
VITE_API_BASE_URL=/api/v1
