# ==============================================================================
# Environment Configuration Template (.env.example)
# SIH 2026 — PS26057: MarineDebris-Sonar-AI
# Copy this file to .env and adjust values for your local environment.
# DO NOT COMMIT REAL SECRETS OR SENSITIVE PASSWORDS TO VERSION CONTROL.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-this-insecure-secret-key-in-production

# PostgreSQL Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=marine_debris_sonar
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/marine_debris_sonar

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=false

# Storage & Uploads
STORAGE_TYPE=local
STORAGE_LOCAL_ROOT=./data/storage
MAX_UPLOAD_SIZE_MB=2048

# Frontend Configuration
VITE_API_BASE_URL=/api/v1
